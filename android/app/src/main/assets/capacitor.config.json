{
	"appId": "org.vrcfamily.app",
	"appName": "PhucHung AZ",
	"webDir": "dist",
	"server": {
		"cleartext": false,
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"ios": {
		"contentInset": "always",
		"preferredContentMode": "mobile",
		"scheme": "Vietnamese Revival Church",
		"backgroundColor": "#FDFCFB",
		"allowsLinkPreview": false,
		"scrollEnabled": true
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
