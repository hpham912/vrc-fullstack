# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional API origin embedded by Vite when the app is built. Leave this empty
# for local web development, which uses the same Express server. The iOS and
# Android release builds set it to the church app URL
# (https://my.vrcfamily.org) in their npm scripts (ios:sync, android:sync),
# because the bundled app has no same-origin server to call.
VITE_API_BASE_URL=""

# FIREBASE_SERVICE_ACCOUNT: Optional JSON string of the service account key
# (e.g. firebase-adminsdk-fbsvc@stunning-decker-801dl.iam.gserviceaccount.com)
# for Firebase Cloud Messaging (FCM) push notifications when not using ADC.
FIREBASE_SERVICE_ACCOUNT=""

# Twilio SMS (member registration + forgot-password codes, sent by text
# to the member's phone). TWILIO_ACCOUNT_SID is the Twilio account SID;
# TWILIO_AUTH_TOKEN is the auth token (keep it secret); TWILIO_PHONE_NUMBER
# is the Twilio number that sends the texts (E.164, e.g. +14805550199).
# Set these as Cloud Run env vars.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

